[Unit]
Description=sfnx instance :8093 on atlas1 (qwen3.8-flash-next 1M, 1110)
After=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
User=atlas
WorkingDirectory=/data/sfnx-prod
ExecStart=/data/sfnx-prod/.venv/bin/python -m front.server --engine sfnx --config serve/sfnx-8093.json
Restart=on-failure
RestartSec=10
LimitMEMLOCK=infinity

[Install]
WantedBy=multi-user.target
